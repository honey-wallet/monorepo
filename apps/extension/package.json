{
  "name": "@honey-wallet/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Honey Wallet for the browser: the wallet in an extension, paired with the phone by QR code.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "exports": {
    "./protocol": "./src/worker/protocol.ts",
    "./router": "./src/worker/router.ts"
  },
  "scripts": {
    "dev": "pnpm --filter @honey-wallet/mobile exec expo start --web",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules/.tmp"
  },
  "dependencies": {
    "@honey-wallet/api-client": "workspace:*",
    "@honey-wallet/keyring": "workspace:*",
    "@scure/base": "2.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "^24.13.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  }
}
