# Copy to .env.local (git-ignored). The build forwards these public settings into the
# Expo single-page extension and adds the API origin to the generated MV3 host permissions.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Must match this installed extension's exact origin and server AUTH_ORIGIN. Chrome
# extension IDs are [a-p]{32}; configure the stable Web Store ID for release builds.
# For unpacked development, inspect chrome://extensions and use its generated ID.
EXPO_PUBLIC_AUTH_ORIGIN=chrome-extension://abcdefghijklmnopabcdefghijklmnop
EXPO_PUBLIC_AUTH_CHAIN_ID=eip155:1

# Set to 1 to show "Demo only" / "Preview only" labels on sample balances and unavailable trading.
# Hidden by default.
EXPO_PUBLIC_SHOW_DEMO_LABELS=0

# Set to 1 for test mode: the real app with fake money. Your wallets show a sample
# portfolio (tokens, cash, activity, NFTs, positions, savings, shared wallets, Bunk mode) so
# every screen is populated; sends, trades and deposits finish without signing anything.
# Prices, quotes and markets stay live. Off by default; never on in release builds.
EXPO_PUBLIC_TEST_MODE=0
