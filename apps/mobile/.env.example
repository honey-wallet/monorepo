# Copy to .env.local (git-ignored). Variables must be prefixed with EXPO_PUBLIC_ to reach the app.
#
# Leave unset in development: the app derives the server address from the Expo
# dev server host, so it works on simulators and physical devices on your LAN
# (start the server with HOST=0.0.0.0 for the latter).
# EXPO_PUBLIC_API_URL=http://localhost:8080

# WalletConnect (Reown) project id, from cloud.reown.com: lets websites connect to the
# phone by WalletConnect QR. Public by design (it ships in the app), but keep it in
# .env.local so each environment can use its own.
# EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
