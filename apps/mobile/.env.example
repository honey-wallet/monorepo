# Copy to .env.local (git-ignored). Variables must be prefixed with EXPO_PUBLIC_ to reach the app.
#
# EAS project UUID, from expo.dev project settings. Public configuration, not a secret.
# Also set in both the preview and production EAS environments. OTA stays disabled
# in local development until this is configured; release profiles require it.
# EAS_PROJECT_ID=
# HONEY_UPDATE_CHANNEL=preview # Only set for local native release builds, not normal development.
# Release builds/updates also require HTTPS API/auth URLs, AUTH_CHAIN_ID and TEST_MODE=0 below.
#
# Leave unset in development: the app derives the server address from the Expo
# dev server host, so it works on simulators and physical devices on your LAN
# (start the server with HOST=0.0.0.0 for the latter).
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Independent trusted SIWE relying-party identity. Must exactly match server AUTH_ORIGIN
# and eip155:<AUTH_CHAIN_ID>; never derive this trust anchor from an API response.
# HTTPS required except loopback development. No signing secrets belong here.
# EXPO_PUBLIC_AUTH_ORIGIN=https://wallet.example.com
# EXPO_PUBLIC_AUTH_CHAIN_ID=eip155:1

# WalletConnect (Reown) project id, from cloud.reown.com: lets websites connect to the
# phone by WalletConnect QR. Public by design (it ships in the app), but keep it in
# .env.local so each environment can use its own.
# EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Clerk publishable key (pk_test_… / pk_live_…): Sign in with Apple, Google and email codes.
# Safe to ship: it is public by design and only identifies your Clerk app. Get it from the
# Clerk Dashboard → API keys. Leave unset to hide the Apple / Google / email buttons; the
# recovery-phrase and import ways in keep working. Clerk never sees keys or phrases.
# Setup: docs/launch/CLERK-SETUP.md. Changing native config needs a new dev/release build.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Set to 1 to show "Demo only" / "Preview only" labels on sample balances and unavailable trading.
# Hidden by default.
EXPO_PUBLIC_SHOW_DEMO_LABELS=0

# Set to 1 for test mode: the real app with fake money. Your wallets show a sample
# portfolio (tokens, cash, activity, NFTs, positions, savings, shared wallets, Bunk mode) so
# every screen is populated; sends, trades and deposits finish without signing anything.
# Prices, quotes and markets stay live. Off by default; never on in release builds.
EXPO_PUBLIC_TEST_MODE=0
