# Copy to .env (git-ignored) and adjust as needed.

# Use 0.0.0.0 to accept connections from other devices (e.g. a phone running Expo Go).
HOST=127.0.0.1
PORT=8080

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

REQUEST_TIMEOUT_SECS=30

# Behind a reverse proxy that sets X-Forwarded-For, set true so per-client limits (the
# pairing mailbox) see real client IPs. Leave false when clients connect directly.
TRUST_PROXY_HEADERS=false

# Log filter (see tracing-subscriber EnvFilter docs) and format (text | json).
RUST_LOG=honey_server=debug,tower_http=debug,info
LOG_FORMAT=text
